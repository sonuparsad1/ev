QWidget {
    background: #0e1320;
    color: #dbe5ff;
    font-family: 'Segoe UI';
    font-size: 13px;
}

QMainWindow, QStackedWidget, QListWidget {
    background: transparent;
}

QLabel#title {
    font-size: 34px;
    font-weight: 700;
    color: #f3f7ff;
}

QWidget#sidebar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(63,75,102,0.5), stop:1 rgba(24,31,48,0.8));
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 16px;
}

QLineEdit, QComboBox, QTableWidget {
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 10px;
    padding: 8px;
}

QPushButton {
    border-radius: 12px;
    padding: 10px 16px;
    background: #27314d;
    border: 1px solid #40517c;
}
QPushButton:hover { background: #32406a; }

SummaryCard, ChargingCard {
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 16px;
}

QLabel#metricValue {
    font-size: 30px;
    font-weight: 700;
    color: #47f0c3;
}

QProgressBar {
    border-radius: 8px;
    background: #1e263b;
    text-align: center;
}
QProgressBar::chunk {
    border-radius: 8px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #3dd9b3, stop:1 #4fa3ff);
}
