QWidget {
    background: #070b15;
    color: #dbe5ff;
    font-family: 'Segoe UI';
    font-size: 13px;
}

QMainWindow, QStackedWidget, QListWidget {
    background: transparent;
}

QFrame#sidebar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(27,34,52,0.82), stop:1 rgba(14,20,34,0.9));
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 20px;
}

QLabel#avatar {
    min-width: 64px;
    min-height: 64px;
    max-width: 64px;
    max-height: 64px;
    border-radius: 32px;
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.8, fx:0.4, fy:0.2,
      stop:0 #47f0c3, stop:1 #26374f);
    color: #08131f;
    font-size: 28px;
    font-weight: 800;
    qproperty-alignment: AlignCenter;
}

QPushButton {
    border-radius: 12px;
    padding: 10px 14px;
    background: rgba(47,61,98,0.6);
    border: 1px solid rgba(115,142,199,0.45);
}
QPushButton:hover {
    background: rgba(76,98,154,0.72);
}
QPushButton#menuBtn[active="true"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #39d8b2, stop:1 #4a8dff);
    color: #071120;
    font-weight: 700;
    padding-left: 18px;
}

QLineEdit, QComboBox, QTableWidget {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 10px;
    padding: 8px;
}

QFrame#statCard, ChargingCard {
    background: rgba(255,255,255,0.055);
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 16px;
}
QFrame#statCard:hover {
    margin-top: -2px;
    border: 1px solid rgba(71,240,195,0.45);
}

QLabel#metricValue {
    font-size: 30px;
    font-weight: 700;
    color: #47f0c3;
}
QLabel#subtle {
    color: #94a7ce;
}
QLabel#chargingLive {
    color: #ff6f91;
    font-weight: 700;
}

QLabel#badgePeak {
    background: rgba(255,90,90,0.25);
    border: 1px solid #ff4d63;
    border-radius: 8px;
    padding: 6px 10px;
}
QLabel#badgeOffpeak {
    background: rgba(42,212,125,0.2);
    border: 1px solid #2ad47d;
    border-radius: 8px;
    padding: 6px 10px;
}

QProgressBar {
    border-radius: 8px;
    background: #1e263b;
    text-align: center;
}
QProgressBar::chunk {
    border-radius: 8px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #3dd9b3, stop:1 #4fa3ff);
}
